# ===========================================================================
# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# VITE_* variables are compiled into the browser bundle and are PUBLIC.
# Everything else is server-only and must never get a VITE_ prefix.
# ===========================================================================

# --- Supabase (client) ------------------------------------------------------
# Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server, /api functions) --------------------------------------
# Same URL as above. The service-role key bypasses row-level security —
# keep it server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (server) --------------------------------------------------------
# Prefer a restricted API key (rk_...) scoped to Checkout Sessions write +
# PaymentIntents read over a full secret key (sk_...).
STRIPE_SECRET_KEY=rk_test_your_restricted_key

# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# The Price to charge. Create it in the Stripe dashboard; this is the
# authoritative source of what the product costs.
STRIPE_PRICE_ID=price_your_price_id

# Fallback used only when STRIPE_PRICE_ID is unset. Amount is in minor units
# (2900 = RM 29.00).
PRICE_AMOUNT=2900
PRICE_CURRENCY=myr

# --- App --------------------------------------------------------------------
# Public origin, used to build Stripe's success/cancel URLs.
# Leave unset on Vercel to fall back to the deployment URL.
APP_URL=http://localhost:5173

# --- Pricing copy (client, display only) ------------------------------------
# Cosmetic. The real charge is whatever Stripe's Price says.
VITE_PRICE_LABEL=RM 29
VITE_PRICE_COMPARE_LABEL=RM 79
VITE_SUPPORT_EMAIL=support@yourdomain.com
